{
	"id":"nsp_antimatter_injector",  # this id must match what's in the spreadsheet
	"specClass":"projectile",
	"type":"DECORATIVE",
	"size":"MEDIUM",
	"everyFrameEffect":"neon.nsp.data.scripts.weapons.NSP_AntimatterInjectorEffect",
	"turretSprite":"",
	"turretGlowSprite":"",
	"hardpointSprite":"",
	"hardpointGlowSprite":"",
	"glowColor":[255,100,255,255],
	"turretOffsets":[6, 0], #15
	"turretAngleOffsets":[0],
	"hardpointOffsets":[8, 0],#15
	"hardpointAngleOffsets":[0],
	"barrelMode":"ALTERNATING", # or LINKED.  whether barrels fire at the same time or alternate.
	"unaffectedByProjectileSpeedBonuses":true,
	"animationType":"GLOW_AND_FLASH",
	"muzzleFlashSpec":{"length":12.0,   # only used if animationType = MUZZLE_FLASH or GLOW_AND_FLASH
					   "spread":4.0,
					   "particleSizeMin":8.0,
					   "particleSizeRange":5.0,
					   "particleDuration":0.3,
					   "particleCount":8,
					   "particleColor":[255,100,255,255]},
	"autocharge":true,  # whether the weapon will continue charging and fire if the LMB is tapped instead of held
	"projectileSpecId":"nsp_antimatter_injector_shot",  # projectile that will be fired
	"noImpactSounds":true,
}