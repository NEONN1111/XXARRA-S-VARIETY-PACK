{
	"id":"nsp_plasma_torpedo",
	"specClass":"missile",
	"missileType":"MISSILE",
	"onHitEffect":"neon.nsp.data.scripts.weapons.NSP_PlasmaTorpedo",
	#"sprite":"graphics/missiles/shell_gauss_cannon.png",
	"sprite":"",
	"size":[10,10],	
	"center":[5,5],
	"collisionRadius":45,
	"collisionClass":"HITS_SHIPS_ONLY_NO_FF",
	"explosionColor":[220,250,226,255],  # purely visual, will get a white additively blended core on top of this color
	"explosionRadius":250, # purely visual,
	"explosionSpec":{
		"duration":0.1f, # not visual
		"radius":175,
		"coreRadius":75, # full damage within core radius
		"collisionClass":HITS_SHIPS_AND_ASTEROIDS,
		"collisionClassByFighter":HITS_SHIPS_AND_ASTEROIDS,
		"particleSizeMin":5.0,
		"particleSizeRange":3.0,
		"particleDuration":1,
		"particleCount":200,
		"particleColor":[255,155,155,255],
		"explosionColor":[255,100,100,255],
		"detailedExplosionFlashColorFringe":[255,100,100,255],
		"detailedExplosionFlashRadius":500,
		"useDetailedExplosion":true
	},
	#"alwaysAccelerate":true,
	#"reduceDamageWhileFading":true,
	#"useProjectileRangeCalculation":true,
	"renderTargetIndicator":false, # no target diamond in combat view, not targeted by flares
	"noCollisionWhileFading":true,
	"useHitGlowWhenDealingDamage":false, # ? look at this
	"useHitGlowWhenDestroyed":true, # instead of the default explosion
	"dudProbabilityOnFlameout":0,
	"fizzleOnReachingWeaponRange":true,					 
	"armingTime":0,
	"flameoutTime":0.5, # total time from flameout to full fadeout
	"noEngineGlowTime":0.5, # time spent without the engine glow being rendered
	"fadeTime":0.5, # fadeout duration			
	"glowColor":[255,100,100,50],
	"glowRadius":125,
	"engineSpec":{"turnAcc":500,
				  "turnRate":100,
				  "acc":300,
				  "dec":300},
	"engineSlots":[{"id":"ES1",
					#"loc":[-7, 0],
					"loc":[0, 0],
				    "style":"CUSTOM",
					"styleSpec":{
						"mode":"QUAD_STRIP", # PARTICLES or QUAD_STRIP, determines which params are used
						"engineColor":[255,100,100,50],
						"glowSizeMult":2.5,
						"glowAlternateColor":[255,100,100,255],
						"contrailDuration":3,
						"contrailWidthMult":2.0,
						"contrailWidthAddedFractionAtEnd":1,  # can be negative. makes trail spread out/narrow at the end
						"contrailMinSeg":5, # min segment length, in pixels
						"contrailMaxSpeedMult":0f,
						"contrailAngularVelocityMult":0.5f,
						"contrailSpawnDistMult":0f, # how far away from engine it starts
						"contrailColor":[255,100,100,200],
						"type":"GLOW" # GLOW or SMOKE; additive or regular blend mode
					},
				    "width":10.0,
				    "length":50.0,
				    "angle":180.0}]
}
			